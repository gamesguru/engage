#!/usr/bin/env bash

watch_dir nix
if command -v nix-shell >/dev/null; then
    use nix nix -A output.shells.default
fi

watch_file .env
if [ -f .env ]; then
    dotenv .env
fi

# Set ENGAGE_AUTOREGEN_SHELLCOMPS_ENVRC=1 in your environment (.env or locally)
# to automatically regenerate completions when direnv loads
if [ "$ENGAGE_AUTOREGEN_SHELLCOMPS_ENVRC" = "1" ] && [ -f "scripts/gen-completions.sh" ]; then
    bash scripts/gen-completions.sh >/dev/null 2>&1
fi

# Auto-load generated dynamic completions
if [ -d "completions/share" ]; then
    export XDG_DATA_DIRS="$PWD/completions/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
fi
